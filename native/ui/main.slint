import { Theme } from "themes.slint";
import { AppCardData, AppSourceData } from "models.slint";
import { WindowTitleBar } from "components/window-titlebar.slint";
import { Sidebar } from "components/sidebar.slint";
import { AppToolbar } from "components/app-toolbar.slint";
import { AppsPage } from "pages/apps.slint";
import { AppDetailPage } from "pages/app-detail.slint";
import { PerformancePage } from "pages/performance.slint";

component PlaceholderPage inherits Rectangle {
    in property <string> page-title;

    background: Theme.content-bg;

    VerticalLayout {
        padding: 34px;
        spacing: 14px;

        Text {
            text: root.page-title;
            color: Theme.text-primary;
            font-size: 28px;
            font-weight: 800;
        }

        Rectangle {
            height: 150px;
            border-radius: 18px;
            border-width: 1px;
            border-color: Theme.card-border;
            background: Theme.card-bg;

            VerticalLayout {
                padding: 24px;
                spacing: 8px;
                alignment: center;

                Text {
                    text: "Esta tela será migrada para Slint.";
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "A implementação Tauri original continua preservada durante a migração.";
                    color: Theme.text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component GameficWindow inherits Window {
    title: "Gamefic";
    no-frame: true;
    resize-border-width: 8px;
    preferred-width: 1540px;
    preferred-height: 960px;
    min-width: 1080px;
    min-height: 700px;
    background: Theme.window-bg;
    default-font-family: "Inter";
    default-font-size: 14px;

    in-out property <bool> dark-theme <=> Theme.dark;
    in-out property <string> selected-page: "Apps";
    in-out property <string> system-status: "Detectando sistema...";
    in-out property <int> update-count: 0;
    in-out property <bool> catalog-loaded: false;
    in-out property <[AppCardData]> launchers: [];
    in-out property <[AppCardData]> emulators: [];
    in-out property <[AppCardData]> game-tools: [];
    in-out property <[AppCardData]> compatibility: [];
    in-out property <string> selected-app-id: "";
    in-out property <bool> detail-loading: false;
    in-out property <string> detail-error: "";
    in-out property <string> detail-name: "";
    in-out property <string> detail-vendor: "";
    in-out property <string> detail-license: "";
    in-out property <string> detail-summary: "";
    in-out property <string> detail-description: "";
    in-out property <bool> detail-gui: false;
    in-out property <[AppSourceData]> detail-sources: [];
    in-out property <bool> action-busy: false;
    in-out property <bool> action-error: false;
    in-out property <string> action-message: "";
    in-out property <int> monitor-interval-ms: 2000;
    in-out property <string> metric-cpu-value: "—";
    in-out property <string> metric-cpu-detail-a: "Aguardando primeira amostra";
    in-out property <string> metric-cpu-detail-b: "Frequência média indisponível";
    in-out property <int> metric-cpu-percent: 0;
    in-out property <string> metric-network-value: "Aguardando dados";
    in-out property <string> metric-network-detail-a: "Download: —";
    in-out property <string> metric-network-detail-b: "Upload: —";
    in-out property <string> metric-network-link: "Conexão não identificada";
    in-out property <string> metric-gpu-value: "Não disponível";
    in-out property <string> metric-gpu-detail-a: "Métricas dependem do driver";
    in-out property <string> metric-gpu-detail-b: "Temperatura: —";
    in-out property <int> metric-gpu-percent: 0;
    in-out property <bool> metric-gpu-available: false;
    in-out property <string> metric-vram-value: "Não disponível";
    in-out property <string> metric-vram-detail-a: "Memória de vídeo indisponível";
    in-out property <string> metric-vram-detail-b: "Uso: —";
    in-out property <int> metric-vram-percent: 0;
    in-out property <bool> metric-vram-available: false;
    in-out property <string> metric-ram-value: "—";
    in-out property <string> metric-ram-detail-a: "Em uso: —";
    in-out property <string> metric-ram-detail-b: "Disponível: —";
    in-out property <int> metric-ram-percent: 0;
    in-out property <string> metric-swap-value: "—";
    in-out property <string> metric-swap-detail-a: "Em uso: —";
    in-out property <string> metric-swap-detail-b: "Disponível: —";
    in-out property <int> metric-swap-percent: 0;
    in-out property <bool> metric-swap-available: false;

    callback app-selected(string);
    callback app-detail-closed();
    callback source-action-requested(string, string, string);
    callback app-open-requested(string);
    callback monitor-interval-changed(int);

    VerticalLayout {
        spacing: 0;

        WindowTitleBar {
            minimize-requested => { root.minimized = true; }
            maximize-requested => { root.maximized = !root.maximized; }
            close-requested => { root.close(); }
        }

        HorizontalLayout {
            spacing: 0;

            Sidebar {
                selected-page: root.selected-page;
                navigate(page) => { root.selected-page = page; }
            }

            VerticalLayout {
                spacing: 0;

                AppToolbar {
                    page-title: root.selected-page;
                    status-text: root.system-status;
                    update-count: root.update-count;
                    dark-theme: root.dark-theme;

                    toggle-theme => { root.dark-theme = !root.dark-theme; }
                    updates-requested => {
                        root.system-status = "O painel de atualizações será migrado na próxima etapa.";
                    }
                    settings-requested => { root.selected-page = "Configurações"; }
                }

                if root.selected-page == "Apps" && root.selected-app-id == "" : AppsPage {
                    launchers: root.launchers;
                    emulators: root.emulators;
                    game-tools: root.game-tools;
                    compatibility: root.compatibility;
                    catalog-loaded: root.catalog-loaded;
                    app-selected(id) => {
                        root.selected-app-id = id;
                        root.detail-loading = true;
                        root.detail-error = "";
                        root.detail-sources = [];
                        root.app-selected(id);
                        root.system-status = "Consultando aplicativo · " + id;
                    }
                }

                if root.selected-page == "Apps" && root.selected-app-id != "" : AppDetailPage {
                    app-name: root.detail-name;
                    app-id: root.selected-app-id;
                    vendor: root.detail-vendor;
                    license: root.detail-license;
                    summary: root.detail-summary;
                    description: root.detail-description;
                    sources: root.detail-sources;
                    loading: root.detail-loading;
                    error: root.detail-error;
                    gui: root.detail-gui;
                    action-busy: root.action-busy;
                    action-error: root.action-error;
                    action-message: root.action-message;
                    source-action-requested(action, source) => {
                        root.source-action-requested(root.selected-app-id, action, source);
                    }
                    open-requested => { root.app-open-requested(root.selected-app-id); }
                    back-requested => {
                        root.selected-app-id = "";
                        root.detail-loading = false;
                        root.app-detail-closed();
                        root.system-status = "Catálogo de aplicativos";
                    }
                }

                if root.selected-page == "Desempenho" : PerformancePage {
                    cpu-value: root.metric-cpu-value;
                    cpu-detail-a: root.metric-cpu-detail-a;
                    cpu-detail-b: root.metric-cpu-detail-b;
                    cpu-percent: root.metric-cpu-percent;
                    network-value: root.metric-network-value;
                    network-detail-a: root.metric-network-detail-a;
                    network-detail-b: root.metric-network-detail-b;
                    network-link: root.metric-network-link;
                    gpu-value: root.metric-gpu-value;
                    gpu-detail-a: root.metric-gpu-detail-a;
                    gpu-detail-b: root.metric-gpu-detail-b;
                    gpu-percent: root.metric-gpu-percent;
                    gpu-available: root.metric-gpu-available;
                    vram-value: root.metric-vram-value;
                    vram-detail-a: root.metric-vram-detail-a;
                    vram-detail-b: root.metric-vram-detail-b;
                    vram-percent: root.metric-vram-percent;
                    vram-available: root.metric-vram-available;
                    ram-value: root.metric-ram-value;
                    ram-detail-a: root.metric-ram-detail-a;
                    ram-detail-b: root.metric-ram-detail-b;
                    ram-percent: root.metric-ram-percent;
                    swap-value: root.metric-swap-value;
                    swap-detail-a: root.metric-swap-detail-a;
                    swap-detail-b: root.metric-swap-detail-b;
                    swap-percent: root.metric-swap-percent;
                    swap-available: root.metric-swap-available;
                    interval-ms: root.monitor-interval-ms;
                    interval-changed(ms) => {
                        root.monitor-interval-ms = ms;
                        root.monitor-interval-changed(ms);
                    }
                }

                if root.selected-page != "Apps" && root.selected-page != "Desempenho" : PlaceholderPage {
                    page-title: root.selected-page;
                }
            }
        }
    }
}
