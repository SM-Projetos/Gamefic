import { Theme } from "../themes.slint";

component WindowControl inherits Rectangle {
    in property <string> glyph;
    in property <color> hover-color: Theme.control-hover;
    callback activated();

    width: 38px;
    height: 34px;
    border-radius: 8px;
    background: touch.has-hover ? root.hover-color : transparent;

    Text {
        text: root.glyph;
        color: Theme.text-primary;
        font-size: 17px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

export component WindowTitleBar inherits Rectangle {
    callback minimize-requested();
    callback maximize-requested();
    callback close-requested();

    height: 36px;
    background: Theme.titlebar-bg;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            text: "GAMEFIC";
            color: Theme.text-muted;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 1.5px;
            vertical-alignment: center;
        }

        WindowMoveArea {
            horizontal-stretch: 1;
            height: 36px;
        }

        HorizontalLayout {
            spacing: 3px;
            WindowControl {
                glyph: "—";
                activated => { root.minimize-requested(); }
            }
            WindowControl {
                glyph: "□";
                activated => { root.maximize-requested(); }
            }
            WindowControl {
                glyph: "×";
                hover-color: #c83d59;
                activated => { root.close-requested(); }
            }
        }
    }

    Rectangle {
        y: root.height - 1px;
        width: root.width;
        height: 1px;
        background: Theme.divider;
    }
}