import { Theme } from "../themes.slint";

component WindowControl inherits Rectangle {
    in property <string> glyph;
    in property <color> hover-color: Theme.control-hover;
    callback activated();

    width: 42px;
    height: 40px;
    border-radius: 10px;
    background: touch.has-hover ? root.hover-color : transparent;

    Text {
        text: root.glyph;
        color: Theme.text-primary;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

export component WindowTitleBar inherits Rectangle {
    callback minimize-requested();
    callback maximize-requested();
    callback close-requested();

    height: 58px;
    background: Theme.titlebar-bg;
    border-bottom-width: 1px;
    border-bottom-color: Theme.divider;

    HorizontalLayout {
        spacing: 10px;
        padding-left: 16px;
        padding-right: 12px;

        HorizontalLayout {
            width: 205px;
            spacing: 10px;
            vertical-alignment: center;

            Image {
                source: @image-url("../../../src/assets/brand/gamefic.png");
                width: 34px;
                height: 34px;
                image-fit: contain;
            }

            Text {
                text: "Gamefic";
                color: Theme.text-primary;
                font-size: 18px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        WindowMoveArea {
            horizontal-stretch: 1;
            height: 58px;

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "⋮⋮";
                    color: Theme.text-muted;
                    font-size: 15px;
                }

                Text {
                    text: "ARRASTE AQUI PARA MOVER A JANELA";
                    color: Theme.text-muted;
                    font-size: 10px;
                    letter-spacing: 1px;
                }
            }
        }

        HorizontalLayout {
            width: 150px;
            spacing: 4px;
            vertical-alignment: center;

            WindowControl {
                glyph: "—";
                activated => { root.minimize-requested(); }
            }

            WindowControl {
                glyph: "□";
                activated => { root.maximize-requested(); }
            }

            WindowControl {
                glyph: "×";
                hover-color: #c83d59;
                activated => { root.close-requested(); }
            }
        }
    }
}
