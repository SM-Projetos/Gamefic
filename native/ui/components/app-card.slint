import { Theme } from "../themes.slint";
import { AppIcon } from "app-icon.slint";
import { StatusBadge } from "status-badge.slint";

export component AppCard inherits Rectangle {
    in property <string> app-id;
    in property <string> app-name;
    in property <string> description;
    in property <string> state: "desconhecido";
    in property <string> glyph;
    in property <bool> raster-icon: false;
    in property <bool> featured: false;
    callback activated(string);

    width: 268px;
    height: 160px;
    border-radius: 14px;
    border-width: root.featured ? 2px : 1px;
    border-color: root.featured ? Theme.accent : Theme.card-border;
    background: Theme.card-bg;
    drop-shadow-color: Theme.card-shadow;
    drop-shadow-blur: 5px;
    drop-shadow-offset-y: 2px;

    VerticalLayout {
        padding: 14px;
        spacing: 9px;

        HorizontalLayout {
            height: 54px;
            spacing: 12px;

            AppIcon {
                app-id: root.app-id;
                glyph: root.glyph;
                raster-icon: root.raster-icon;
            }

            Text {
                text: root.app-name;
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 700;
                wrap: word-wrap;
                max-lines: 2;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.description;
            color: Theme.text-secondary;
            font-size: 11px;
            wrap: word-wrap;
            max-lines: 2;
            height: 30px;
            vertical-alignment: top;
        }

        HorizontalLayout {
            height: 27px;
            spacing: 8px;
            StatusBadge { state: root.state; }
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }
            Text {
                text: "›";
                color: Theme.accent;
                font-size: 22px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.activated(root.app-id); }
    }
}