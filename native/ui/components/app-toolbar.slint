import { Theme } from "../themes.slint";

component ToolbarAction inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <int> count: 0;
    in property <bool> compact: false;
    callback activated();

    height: 34px;
    min-width: 36px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: touch.has-hover ? Theme.control-hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;

        Text {
            text: root.glyph;
            color: Theme.text-secondary;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
        }

        if !root.compact : Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }

        if root.count > 0 : Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: Theme.warning;
            Text {
                text: "\\{root.count}";
                color: #ffffff;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

export component AppToolbar inherits Rectangle {
    in property <string> page-title: "Apps";
    in property <string> status-text: "Detectando sistema...";
    in property <int> update-count: 0;
    in property <bool> dark-theme: true;

    callback toggle-theme();
    callback updates-requested();
    callback settings-requested();

    height: 56px;
    background: Theme.toolbar-bg;

    Rectangle {
        y: root.height - 1px;
        width: root.width;
        height: 1px;
        background: Theme.divider;
    }

    HorizontalLayout {
        spacing: 12px;
        padding-left: 24px;
        padding-right: 18px;

        Text {
            text: root.page-title == "Desempenho" ? "Monitor do Sistema" : root.page-title;
            color: Theme.text-primary;
            font-size: 18px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        Rectangle {
            height: 30px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.card-border;
            background: Theme.card-bg;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 7px;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 4px;
                    background: #34d399;
                }
                Text {
                    text: root.status-text;
                    color: Theme.text-secondary;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        ToolbarAction {
            glyph: "↻";
            label: "Atualizações";
            count: root.update-count;
            activated => { root.updates-requested(); }
        }
        ToolbarAction {
            glyph: root.dark-theme ? "☼" : "◐";
            label: "Tema";
            compact: true;
            activated => { root.toggle-theme(); }
        }
        ToolbarAction {
            glyph: "⚙";
            label: "Configurações";
            compact: true;
            activated => { root.settings-requested(); }
        }
    }
}