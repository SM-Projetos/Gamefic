import { Theme } from "../themes.slint";

export component SectionHeader inherits Rectangle {
    in property <string> title;
    width: 100%;
    height: 28px;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 10px;

        Rectangle {
            width: 3px;
            height: 20px;
            border-radius: 2px;
            background: Theme.accent;
            vertical-stretch: 0;
        }

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: 18px;
            font-weight: 650;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 1px;
            background: Theme.divider;
            vertical-alignment: center;
        }
    }
}