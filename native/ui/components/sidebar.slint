import { Theme } from "../themes.slint";

component NavigationItem inherits Rectangle {
    in property <string> page-key;
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected;
    callback activated();

    height: 40px;
    border-radius: 9px;
    background: root.selected ? Theme.accent-soft
        : touch.has-hover ? Theme.control-hover : transparent;

    Rectangle {
        visible: root.selected;
        x: 0;
        y: 7px;
        width: 3px;
        height: 26px;
        border-radius: 2px;
        background: Theme.accent;
    }

    HorizontalLayout {
        spacing: 12px;
        padding-left: 12px;
        padding-right: 10px;

        Text {
            text: root.glyph;
            width: 22px;
            color: root.selected ? Theme.accent-strong : Theme.text-secondary;
            font-size: 17px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            font-size: 13px;
            font-weight: root.selected ? 700 : 500;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

export component Sidebar inherits Rectangle {
    in property <string> selected-page: "Apps";
    callback navigate(string);

    width: 224px;
    background: Theme.sidebar-bg;

    Rectangle {
        x: root.width - 1px;
        width: 1px;
        height: root.height;
        background: Theme.divider;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 5px;

        VerticalLayout {
            height: 126px;
            spacing: 7px;
            alignment: center;

            Image {
                source: @image-url("../../../src/assets/brand/gamefic.png");
                width: 72px;
                height: 72px;
                image-fit: contain;
            }

            Text {
                text: "Gamefic";
                color: Theme.text-primary;
                font-size: 22px;
                font-weight: 700;
                horizontal-alignment: center;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        NavigationItem {
            page-key: "Apps";
            label: "Apps";
            glyph: "▦";
            selected: root.selected-page == page-key;
            activated => { root.navigate(page-key); }
        }
        NavigationItem {
            page-key: "Criação de Conteúdo";
            label: "Criação de Conteúdo";
            glyph: "▷";
            selected: root.selected-page == page-key;
            activated => { root.navigate(page-key); }
        }
        NavigationItem {
            page-key: "Desempenho";
            label: "Monitor do Sistema";
            glyph: "⌁";
            selected: root.selected-page == page-key;
            activated => { root.navigate(page-key); }
        }
        NavigationItem {
            page-key: "Kernels e Drivers";
            label: "Kernels e Drivers";
            glyph: "▦";
            selected: root.selected-page == page-key;
            activated => { root.navigate(page-key); }
        }
        NavigationItem {
            page-key: "Otimização";
            label: "Otimização";
            glyph: "⚙";
            selected: root.selected-page == page-key;
            activated => { root.navigate(page-key); }
        }
        NavigationItem {
            page-key: "Overlay";
            label: "Overlay";
            glyph: "▣";
            selected: root.selected-page == page-key;
            activated => { root.navigate(page-key); }
        }
        NavigationItem {
            page-key: "Histórico e Diagnósticos";
            label: "Histórico e Diagnósticos";
            glyph: "◷";
            selected: root.selected-page == page-key;
            activated => { root.navigate(page-key); }
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
        }

        Rectangle {
            height: 54px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.card-border;
            background: Theme.card-bg;

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                spacing: 3px;

                Text {
                    text: "Gamefic";
                    color: Theme.text-primary;
                    font-size: 12px;
                    font-weight: 700;
                }
                Text {
                    text: "Versão nativa · Slint";
                    color: Theme.text-muted;
                    font-size: 10px;
                }
            }
        }
    }
}