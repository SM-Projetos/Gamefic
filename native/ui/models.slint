// Shared data contracts for the Gamefic Slint UI.
// Keep these presentation models independent from backend-specific types.
export struct AppCardData {
    id: string,
    name: string,
    description: string,
    state: string,
    glyph: string,
    raster_icon: bool,
}


export struct AppSourceData {
    id: string,
    name: string,
    available: bool,
    installed: bool,
    version: string,
    repository_version: string,
    reason: string,
    indeterminate: bool,
}
