// Tokens alinhados à identidade visual da interface Tauri original.
export global Theme {
    in-out property <bool> dark: true;

    out property <color> window-bg: dark ? #0d0f14 : #cfe2f8;
    out property <color> titlebar-bg: dark ? #11141c : #bcd7f8;
    out property <color> sidebar-bg: dark ? #11141c : #bcd7f8;
    out property <color> toolbar-bg: dark ? #11141c : #bcd7f8;
    out property <color> content-bg: dark ? #0d0f14 : #cfe2f8;

    out property <color> card-bg: dark ? #171b25 : #e6f1fd;
    out property <color> card-bg-alt: dark ? #1d2230 : #f4f9ff;
    out property <color> card-border: dark ? #2a3040 : #9fc4f0;
    out property <color> card-shadow: dark ? #00000059 : #16324f1f;

    out property <color> text-primary: dark ? #f3f4f8 : #0d1b2a;
    out property <color> text-secondary: dark ? #a1a8b8 : #2a4266;
    out property <color> text-muted: dark ? #7d879a : #58749b;

    out property <color> accent: dark ? #8b5cf6 : #2456d6;
    out property <color> accent-strong: dark ? #a78bfa : #1d4ed8;
    out property <color> accent-soft: dark ? #38265f : #2456d624;
    out property <color> accent-border: dark ? #7650c8 : #6d9ce8;

    out property <color> success: dark ? #34d399 : #047857;
    out property <color> info: dark ? #22d3ee : #0e7490;
    out property <color> warning: dark ? #fbbf24 : #c2410c;
    out property <color> danger: dark ? #f87171 : #b91c1c;

    out property <color> divider: dark ? #2a3040 : #9fc4f0;
    out property <color> icon-tile: dark ? #242039 : #d8e8fb;
    out property <color> control-hover: dark ? #242039 : #d8e8fb;
    out property <color> control-bg: dark ? #1d2230 : #f4f9ff;
}