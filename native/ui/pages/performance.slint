import { Theme } from "../themes.slint";

component IntervalOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated();

    width: 58px;
    height: 30px;
    border-radius: 9px;
    border-width: root.selected ? 1px : 0px;
    border-color: root.selected ? Theme.accent-border : transparent;
    background: root.selected ? Theme.accent-soft : Theme.control-bg;

    Text {
        text: root.label;
        color: root.selected ? Theme.accent : Theme.text-secondary;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    option-touch := TouchArea {
        clicked => { root.activated(); }
    }
}

component MetricCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> detail-a;
    in property <string> detail-b;
    in property <int> percent: 0;
    in property <color> bar-color: Theme.accent;
    in property <bool> show-meter: true;

    height: 218px;
    border-radius: 17px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-bg;
    drop-shadow-color: Theme.card-shadow;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 3px;

    VerticalLayout {
        padding: 17px;
        spacing: 10px;

        Text {
            text: root.title;
            color: Theme.text-secondary;
            font-size: 12px;
            font-weight: 700;
        }

        Text {
            text: root.value;
            color: Theme.text-primary;
            font-size: 29px;
            font-weight: 800;
            vertical-alignment: center;
        }

        Text {
            text: root.detail-a;
            color: Theme.text-secondary;
            font-size: 11px;
            wrap: word-wrap;
        }

        Text {
            text: root.detail-b;
            color: Theme.text-muted;
            font-size: 10px;
            wrap: word-wrap;
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
        }

        if root.show-meter : Rectangle {
            height: 7px;
            border-radius: 4px;
            background: Theme.control-bg;
            clip: true;

            Rectangle {
                width: root.percent * 2.7px;
                height: 7px;
                border-radius: 4px;
                background: root.bar-color;
            }
        }
    }
}

export component PerformancePage inherits Rectangle {
    in property <string> cpu-value: "—";
    in property <string> cpu-detail-a: "Aguardando primeira amostra";
    in property <string> cpu-detail-b: "Frequência média indisponível";
    in property <int> cpu-percent: 0;

    in property <string> network-value: "Aguardando dados";
    in property <string> network-detail-a: "Download: —";
    in property <string> network-detail-b: "Upload: —";
    in property <string> network-link: "Conexão não identificada";

    in property <string> gpu-value: "Não disponível";
    in property <string> gpu-detail-a: "Métricas dependem do driver";
    in property <string> gpu-detail-b: "Temperatura: —";
    in property <int> gpu-percent: 0;
    in property <bool> gpu-available: false;

    in property <string> vram-value: "Não disponível";
    in property <string> vram-detail-a: "Memória de vídeo indisponível";
    in property <string> vram-detail-b: "Uso: —";
    in property <int> vram-percent: 0;
    in property <bool> vram-available: false;

    in property <string> ram-value: "—";
    in property <string> ram-detail-a: "Em uso: —";
    in property <string> ram-detail-b: "Disponível: —";
    in property <int> ram-percent: 0;

    in property <string> swap-value: "—";
    in property <string> swap-detail-a: "Em uso: —";
    in property <string> swap-detail-b: "Disponível: —";
    in property <int> swap-percent: 0;
    in property <bool> swap-available: false;

    in property <int> interval-ms: 2000;
    callback interval-changed(int);

    background: Theme.content-bg;

    VerticalLayout {
        padding-left: 26px;
        padding-right: 26px;
        padding-top: 23px;
        padding-bottom: 28px;
        spacing: 18px;

        HorizontalLayout {
            height: 58px;
            spacing: 12px;

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "Monitor do Sistema";
                    color: Theme.text-primary;
                    font-size: 27px;
                    font-weight: 800;
                }

                Text {
                    text: "Métricas em tempo real do hardware e da rede";
                    color: Theme.text-secondary;
                    font-size: 11px;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            Text {
                text: "INTERVALO";
                color: Theme.text-muted;
                font-size: 9px;
                font-weight: 700;
                vertical-alignment: center;
            }

            IntervalOption {
                label: "1 s";
                selected: root.interval-ms == 1000;
                activated => { root.interval-changed(1000); }
            }
            IntervalOption {
                label: "2 s";
                selected: root.interval-ms == 2000;
                activated => { root.interval-changed(2000); }
            }
            IntervalOption {
                label: "5 s";
                selected: root.interval-ms == 5000;
                activated => { root.interval-changed(5000); }
            }
        }

        HorizontalLayout {
            spacing: 14px;
            MetricCard {
                horizontal-stretch: 1;
                title: "CPU";
                value: root.cpu-value;
                detail-a: root.cpu-detail-a;
                detail-b: root.cpu-detail-b;
                percent: root.cpu-percent;
                bar-color: #a78bfa;
            }
            MetricCard {
                horizontal-stretch: 1;
                title: "REDE";
                value: root.network-value;
                detail-a: root.network-detail-a;
                detail-b: root.network-detail-b;
                show-meter: false;
            }
            MetricCard {
                horizontal-stretch: 1;
                title: "GPU";
                value: root.gpu-value;
                detail-a: root.gpu-detail-a;
                detail-b: root.gpu-detail-b;
                percent: root.gpu-percent;
                bar-color: #22d3ee;
                show-meter: root.gpu-available;
            }
        }

        HorizontalLayout {
            spacing: 14px;
            MetricCard {
                horizontal-stretch: 1;
                title: "VRAM";
                value: root.vram-value;
                detail-a: root.vram-detail-a;
                detail-b: root.vram-detail-b;
                percent: root.vram-percent;
                bar-color: #a78bfa;
                show-meter: root.vram-available;
            }
            MetricCard {
                horizontal-stretch: 1;
                title: "MEMÓRIA RAM";
                value: root.ram-value;
                detail-a: root.ram-detail-a;
                detail-b: root.ram-detail-b;
                percent: root.ram-percent;
                bar-color: #a78bfa;
            }
            MetricCard {
                horizontal-stretch: 1;
                title: "SWAP";
                value: root.swap-value;
                detail-a: root.swap-detail-a;
                detail-b: root.swap-detail-b;
                percent: root.swap-percent;
                bar-color: #22d3ee;
                show-meter: root.swap-available;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
        }

        Text {
            text: "Dados indisponíveis são exibidos sem estimativas. A telemetria da GPU depende do suporte do driver.";
            color: Theme.text-muted;
            font-size: 10px;
            wrap: word-wrap;
        }
    }
}
