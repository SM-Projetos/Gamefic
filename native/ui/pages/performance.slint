import { Theme } from "../themes.slint";

component IntervalOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated();

    width: 54px;
    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.card-border;
    background: root.selected ? Theme.accent-soft : Theme.control-bg;

    Text {
        text: root.label;
        color: root.selected ? Theme.accent-strong : Theme.text-secondary;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    option-touch := TouchArea { clicked => { root.activated(); } }
}

component MetricChart inherits Rectangle {
    in property <string> path-data;
    in property <color> line-color: Theme.accent;
    height: 64px;
    background: transparent;

    Rectangle {
        y: 16px;
        width: 100%;
        height: 1px;
        background: Theme.divider;
    }
    Rectangle {
        y: 40px;
        width: 100%;
        height: 1px;
        background: Theme.divider;
    }
    Path {
        commands: root.path-data;
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.line-color;
        stroke-width: 2.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}

component MetricCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> detail-a;
    in property <string> detail-b;
    in property <string> history-path;
    in property <color> line-color: Theme.accent;

    height: 224px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-bg;
    drop-shadow-color: Theme.card-shadow;
    drop-shadow-blur: 5px;
    drop-shadow-offset-y: 2px;

    VerticalLayout {
        padding: 15px;
        spacing: 9px;

        HorizontalLayout {
            Text {
                text: root.title;
                color: Theme.text-secondary;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 4px;
                background: root.line-color;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.value;
            color: Theme.text-primary;
            font-size: 27px;
            font-weight: 750;
            vertical-alignment: center;
        }

        Text {
            text: root.detail-a;
            color: Theme.text-secondary;
            font-size: 10px;
            wrap: word-wrap;
            max-lines: 2;
        }
        Text {
            text: root.detail-b;
            color: Theme.text-muted;
            font-size: 10px;
            wrap: word-wrap;
            max-lines: 2;
        }

        Rectangle { vertical-stretch: 1; background: transparent; }
        MetricChart {
            path-data: root.history-path;
            line-color: root.line-color;
        }
    }
}

component MemoryColumn inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> detail-a;
    in property <string> detail-b;
    in property <string> history-path;
    in property <color> line-color: Theme.accent;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Text {
            text: root.title;
            color: Theme.text-secondary;
            font-size: 12px;
            font-weight: 700;
        }
        Text {
            text: root.value;
            color: Theme.text-primary;
            font-size: 25px;
            font-weight: 750;
        }
        Text {
            text: root.detail-a;
            color: Theme.text-secondary;
            font-size: 10px;
            wrap: word-wrap;
        }
        Text {
            text: root.detail-b;
            color: Theme.text-muted;
            font-size: 10px;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
        MetricChart {
            path-data: root.history-path;
            line-color: root.line-color;
        }
    }
}

export component PerformancePage inherits Rectangle {
    in property <string> cpu-value: "—";
    in property <string> cpu-detail-a: "Aguardando primeira amostra";
    in property <string> cpu-detail-b: "Frequência média indisponível";
    in property <string> cpu-history-path: "";

    in property <string> network-value: "Aguardando dados";
    in property <string> network-detail-a: "Download: —";
    in property <string> network-detail-b: "Upload: —";
    in property <string> network-history-path: "";

    in property <string> gpu-value: "Não disponível";
    in property <string> gpu-detail-a: "Métricas dependem do driver";
    in property <string> gpu-detail-b: "Temperatura: —";
    in property <string> gpu-history-path: "";

    in property <string> vram-value: "Não disponível";
    in property <string> vram-detail-a: "Memória de vídeo indisponível";
    in property <string> vram-detail-b: "Uso: —";
    in property <string> vram-history-path: "";

    in property <string> ram-value: "—";
    in property <string> ram-detail-a: "Em uso: —";
    in property <string> ram-detail-b: "Disponível: —";
    in property <string> ram-history-path: "";

    in property <string> swap-value: "—";
    in property <string> swap-detail-a: "Em uso: —";
    in property <string> swap-detail-b: "Disponível: —";
    in property <string> swap-history-path: "";
    in property <bool> swap-available: false;

    in property <int> interval-ms: 2000;
    callback interval-changed(int);

    background: Theme.content-bg;

    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-top: 22px;
        padding-bottom: 24px;
        spacing: 16px;

        HorizontalLayout {
            height: 52px;
            spacing: 12px;

            VerticalLayout {
                spacing: 3px;
                Text {
                    text: "Monitor do Sistema";
                    color: Theme.text-primary;
                    font-size: 27px;
                    font-weight: 750;
                }
                Text {
                    text: "Métricas em tempo real do hardware e da rede";
                    color: Theme.text-secondary;
                    font-size: 11px;
                }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: "INTERVALO";
                color: Theme.text-muted;
                font-size: 9px;
                font-weight: 700;
                vertical-alignment: center;
            }
            IntervalOption {
                label: "1 s";
                selected: root.interval-ms == 1000;
                activated => { root.interval-changed(1000); }
            }
            IntervalOption {
                label: "2 s";
                selected: root.interval-ms == 2000;
                activated => { root.interval-changed(2000); }
            }
            IntervalOption {
                label: "5 s";
                selected: root.interval-ms == 5000;
                activated => { root.interval-changed(5000); }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            MetricCard {
                horizontal-stretch: 1;
                title: "CPU";
                value: root.cpu-value;
                detail-a: root.cpu-detail-a;
                detail-b: root.cpu-detail-b;
                history-path: root.cpu-history-path;
                line-color: #a78bfa;
            }
            MetricCard {
                horizontal-stretch: 1;
                title: "REDE";
                value: root.network-value;
                detail-a: root.network-detail-a;
                detail-b: root.network-detail-b;
                history-path: root.network-history-path;
                line-color: #22d3ee;
            }
            MetricCard {
                horizontal-stretch: 1;
                title: "GPU";
                value: root.gpu-value;
                detail-a: root.gpu-detail-a;
                detail-b: root.gpu-detail-b;
                history-path: root.gpu-history-path;
                line-color: #22d3ee;
            }
            MetricCard {
                horizontal-stretch: 1;
                title: "VRAM";
                value: root.vram-value;
                detail-a: root.vram-detail-a;
                detail-b: root.vram-detail-b;
                history-path: root.vram-history-path;
                line-color: #a78bfa;
            }
        }

        HorizontalLayout {
            spacing: 12px;

            Rectangle {
                horizontal-stretch: 3;
                height: 232px;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.card-border;
                background: Theme.card-bg;

                HorizontalLayout {
                    MemoryColumn {
                        horizontal-stretch: 1;
                        title: "MEMÓRIA RAM";
                        value: root.ram-value;
                        detail-a: root.ram-detail-a;
                        detail-b: root.ram-detail-b;
                        history-path: root.ram-history-path;
                        line-color: #a78bfa;
                    }
                    Rectangle {
                        width: 1px;
                        height: 190px;
                        background: Theme.divider;
                        vertical-alignment: center;
                    }
                    MemoryColumn {
                        horizontal-stretch: 1;
                        title: "SWAP";
                        value: root.swap-value;
                        detail-a: root.swap-detail-a;
                        detail-b: root.swap-detail-b;
                        history-path: root.swap-history-path;
                        line-color: #22d3ee;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 2;
                height: 232px;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.card-border;
                background: Theme.card-bg;

                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    Text {
                        text: "ARMAZENAMENTO";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 700;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Text {
                        text: "Leitura de unidades ainda não integrada ao monitor nativo.";
                        color: Theme.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Nenhuma capacidade ou utilização é estimada.";
                        color: Theme.text-muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Text {
            text: "Dados indisponíveis são exibidos sem estimativas. A telemetria da GPU depende do suporte do driver.";
            color: Theme.text-muted;
            font-size: 10px;
            wrap: word-wrap;
        }
    }
}